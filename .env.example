# .env にコピーして値を設定する（.env は GitHub にコミットしない）

# PostgreSQL（Cloud Run から Cloud SQL へは /cloudsql/<インスタンス接続名> を指定する）
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_DATABASE=

# Google Cloud Storage
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
# 改行は \n に置き換えて1行で書く
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GCP_BUCKET_NAME=

# セッション Cookie 署名用の秘密鍵（例: openssl rand -base64 32）
SESSION_SECRET=

# 公開ページURLのドメイン部分（末尾の / は付けない）
APP_BASE_URL=http://localhost:3000
